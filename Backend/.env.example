ENV=production

# === DATABASE ===
# For local development, SQLite is fine (default)
DATABASE_URL=sqlite:///./portfolio.db
# For production, use a persistent DB — see README for options:
# DATABASE_URL=postgresql://user:password@host:5432/portfolio_db
# Keep false in production so cold starts do not spend time checking/creating tables.
AUTO_CREATE_TABLES=false

# === JWT SECURITY ===
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET

# Token expiry in minutes (default 480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# === ADMIN AUTH ===
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt(12)).decode())"
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH

# === CORS ===
# Comma-separated list of allowed frontend origins
# Use your live domain in production e.g. https://rishabhsurana.com
ALLOWED_ORIGINS=http://localhost:5173

# === CONTACT EMAIL NOTIFICATIONS ===
# Optional: when configured, each contact-form submission is saved to the DB
# and also emailed to CONTACT_NOTIFICATION_EMAIL.
# Gmail setup:
# 1. Enable 2-Step Verification on the sending Google account.
# 2. Create a Google App Password and use that value for SMTP_PASSWORD.
# 3. SMTP_FROM_EMAIL should be the Gmail address used for SMTP_USERNAME,
#    unless you have configured a verified Gmail sender alias.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Rishabh Portfolio
CONTACT_NOTIFICATION_EMAIL=rspsurana@gmail.com

# Use TLS for port 587. Use SSL for port 465.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=5

# === LOCATION LOOKUP ===
# Reverse-geocodes consented visitor coordinates to city/region/country.
LOCATION_LOOKUP_ENABLED=true
LOCATION_LOOKUP_TIMEOUT_SECONDS=4
LOCATION_LOOKUP_USER_AGENT=RishabhPortfolio/1.0 (+https://rishabh-surana.netlify.app/)
