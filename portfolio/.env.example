# The hidden admin panel route. Change this to something only you know.
# Access your admin at: https://yoursite.com/<VITE_ADMIN_ROUTE>
VITE_ADMIN_ROUTE=rishabh-rs-ctrl

# The public-facing backend API base URL
# Change to your deployed backend URL in production
VITE_API_BASE_URL=http://localhost:8000

# Optional: set this when you want the GitHub card to show your exact
# logged-in/private-inclusive contribution count instead of the public count.
VITE_GITHUB_CONTRIBUTIONS_LAST_YEAR=
